// Prisma schema for Incident Service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
}

enum IncidentCategory {
  HARDWARE
  SOFTWARE
  NETWORK
  SECURITY
  ACCESS
  OTHER
}

model Incident {
  id              String            @id @default(uuid())
  number          String            @unique  // INC-000001
  subject         String
  description     String
  priority        IncidentPriority  @default(MEDIUM)
  status          IncidentStatus    @default(OPEN)
  category        IncidentCategory  @default(OTHER)
  
  // People
  reporterId      String            @map("reporter_id")
  reporterEmail   String            @map("reporter_email")
  reporterName    String            @map("reporter_name")
  assigneeId      String?           @map("assignee_id")
  assigneeName    String?           @map("assignee_name")
  
  // SLA
  slaDefinitionId String?           @map("sla_definition_id")
  slaDefinition   SlaDefinition?    @relation(fields: [slaDefinitionId], references: [id])
  responseDeadline DateTime?        @map("response_deadline")
  resolutionDeadline DateTime?      @map("resolution_deadline")
  respondedAt     DateTime?         @map("responded_at")
  resolvedAt      DateTime?         @map("resolved_at")
  slaBreached     Boolean           @default(false) @map("sla_breached")
  
  // Source
  source          String            @default("web")  // web, email, api
  emailMessageId  String?           @map("email_message_id")
  
  // Timestamps
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  closedAt        DateTime?         @map("closed_at")
  
  // Relations
  messages        Message[]
  attachments     Attachment[]
  survey          SatisfactionSurvey?
  slaRecords      SlaRecord[]
  
  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([createdAt])
  @@map("incidents")
}

model SlaDefinition {
  id                  String      @id @default(uuid())
  name                String      @unique
  description         String?
  priority            IncidentPriority
  responseTimeMinutes Int         @map("response_time_minutes")
  resolutionTimeMinutes Int       @map("resolution_time_minutes")
  isActive            Boolean     @default(true) @map("is_active")
  
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  
  incidents           Incident[]
  
  @@map("sla_definitions")
}

model SlaRecord {
  id              String    @id @default(uuid())
  incidentId      String    @map("incident_id")
  incident        Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  type            String    // response, resolution
  deadline        DateTime
  completedAt     DateTime? @map("completed_at")
  breached        Boolean   @default(false)
  
  createdAt       DateTime  @default(now()) @map("created_at")
  
  @@map("sla_records")
}

model Message {
  id          String    @id @default(uuid())
  incidentId  String    @map("incident_id")
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  senderId    String    @map("sender_id")
  senderName  String    @map("sender_name")
  senderType  String    @default("user")  // user, system, agent
  content     String
  isInternal  Boolean   @default(false) @map("is_internal")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  
  @@index([incidentId])
  @@map("messages")
}

model Attachment {
  id          String    @id @default(uuid())
  incidentId  String    @map("incident_id")
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  filename    String
  mimeType    String    @map("mime_type")
  size        Int
  path        String
  
  uploadedBy  String    @map("uploaded_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  
  @@map("attachments")
}

model SatisfactionSurvey {
  id          String    @id @default(uuid())
  incidentId  String    @unique @map("incident_id")
  incident    Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  rating      Int       // 1-5
  comment     String?
  
  submittedBy String    @map("submitted_by")
  submittedAt DateTime  @default(now()) @map("submitted_at")
  
  @@map("satisfaction_surveys")
}
